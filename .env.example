# Base de données PostgreSQL (ex: Supabase, Neon, ou local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rihlat_bladna?schema=public"

# Authentification (NextAuth / JWT Secret)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-change-in-production-min-32-chars"

# Passerelles de Paiement
# CMI (Centre Monétique Interbancaire Maroc)
CMI_MERCHANT_ID="12345678"
CMI_STORE_KEY="cmi_secret_store_key"
CMI_GATEWAY_URL="https://testpayment.cmi.co.ma/fim/est3Dgate"

# Stripe (Paiements internationaux / Cartes étrangères)
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""

# WhatsApp Business API (UltraMsg, Twilio ou Infobip)
WHATSAPP_API_URL="https://api.ultramsg.com/instanceXXXX/messages/chat"
WHATSAPP_API_TOKEN="whatsapp_api_token_here"

# Stockage Cloud (Cloudinary ou AWS S3 pour reçus de virement et photos)
CLOUDINARY_CLOUD_NAME="rihlat-bladna"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
